# Токен Telegram-бота, который получен от @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=

# ID чата (или канала/группы), куда бот будет присылать заявки.
# Проще всего узнать так: напишите боту @userinfobot в Telegram — он пришлёт ваш chat_id.
TELEGRAM_CHAT_ID=

# Боевой адрес сайта. От него зависят sitemap.xml, robots.txt, llms.txt
# и микроразметка schema.org. На боевом хостинге обязателен — без него
# карта сайта соберётся с пустыми ссылками.
NEXT_PUBLIC_SITE_URL=https://zel-servis.ru

# Режим превью: закрывает сайт от индексации и показывает жёлтый баннер.
# На боевом хостинге НЕ задавать (или оставить пустым) — иначе рабочий
# сайт останется невидимым для поиска.
NEXT_PUBLIC_PREVIEW=
