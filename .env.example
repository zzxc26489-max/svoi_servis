# Токен Telegram-бота, который получен от @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=

# ID чата (или канала/группы), куда бот будет присылать заявки.
# Проще всего узнать так: напишите боту @userinfobot в Telegram — он пришлёт ваш chat_id.
TELEGRAM_CHAT_ID=

# Контактный телефон, который показывается на сайте (в формате +7XXXXXXXXXX)
NEXT_PUBLIC_CONTACT_PHONE=+7 (900) 000-00-00

# Ссылка на Telegram для связи (username бота/менеджера), например https://t.me/your_username
NEXT_PUBLIC_CONTACT_TELEGRAM=https://t.me/your_username
